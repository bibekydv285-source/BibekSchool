# BibekSchool - Environment Variables for Local Development
# Copy this file to .env and fill in your values
# NEVER commit .env to source control!

# =============================================================================
# AZURE SQL DATABASE CONNECTION STRING
# =============================================================================
# Option 1: SQL Authentication (username/password)
ConnectionStrings__DefaultConnection="Server=tcp:YOUR_SERVER_NAME.database.windows.net,1433;Initial Catalog=BibekSchool;Persist Security Info=False;User ID=sqladmin;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# Option 2: Azure AD Authentication (Managed Identity) - for Azure App Service only
# ConnectionStrings__DefaultConnection="Server=tcp:YOUR_SERVER_NAME.database.windows.net,1433;Initial Catalog=BibekSchool;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default;"

# Option 3: Azure AD Authentication (Service Principal) - for CI/CD
# ConnectionStrings__DefaultConnection="Server=tcp:YOUR_SERVER_NAME.database.windows.net,1433;Initial Catalog=BibekSchool;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Service Principal;User ID=YOUR_CLIENT_ID;Password=YOUR_CLIENT_SECRET;"

# =============================================================================
# EMAIL SETTINGS (for password reset, notifications)
# =============================================================================
Email__SmtpServer="smtp.gmail.com"
Email__SmtpPort="587"
Email__SmtpUsername="your-email@gmail.com"
Email__SmtpPassword="your-app-password"  # Use App Password, not account password
Email__FromEmail="your-email@gmail.com"
Email__FromName="Bibek School"
Email__EnableSsl="true"
Email__UseMock="false"  # Set to "true" to disable email sending in development

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
Application__Name="Bibek School"
Application__Version="1.0.0"
Application__AcademicYear="2024-2025"
Application__DefaultLanguage="en"
Application__TimeZone="Asia/Kathmandu"

# =============================================================================
# PASSWORD RESET SETTINGS
# =============================================================================
PasswordReset__OtpExpiryMinutes="10"
PasswordReset__ResendCooldownSeconds="60"
PasswordReset__MaxAttemptsPerHour="3"
PasswordReset__MaxOtpAttempts="5"

# =============================================================================
# IDENTITY SETTINGS (can also be in appsettings.json)
# =============================================================================
Identity__Password__RequireDigit="true"
Identity__Password__RequireLowercase="false"
Identity__Password__RequireNonAlphanumeric="false"
Identity__Password__RequireUppercase="false"
Identity__Password__RequiredLength="6"
Identity__Password__RequiredUniqueChars="1"
Identity__Lockout__DefaultLockoutTimeSpan="00:05:00"
Identity__Lockout__MaxFailedAccessAttempts="5"
Identity__Lockout__AllowedForNewUsers="true"
Identity__User__RequireUniqueEmail="true"
Identity__SignIn__RequireConfirmedEmail="false"
Identity__SignIn__RequireConfirmedPhoneNumber="false"

# =============================================================================
# COOKIE SETTINGS
# =============================================================================
Cookie__HttpOnly="true"
Cookie__SecurePolicy="Always"
Cookie__SameSite="Lax"
Cookie__ExpireTimeSpan="00:30:00"
Cookie__SlidingExpiration="true"