@model List<BibekSchool.Models.Result>
@{
    ViewData["Title"] = "Manage Results";
    Layout = "_AdminLayout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0">Results</h1>
                <p class="text-muted">View and manage student results</p>
            </div>
            <a href="@Url.Action("Generate", "Result")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Generate Result
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Admission No.</th>
                            <th>Class</th>
                            <th>Term</th>
                            <th>Academic Year</th>
                            <th>Total Marks</th>
                            <th>Percentage</th>
                            <th>Grade</th>
                            <th>Rank</th>
                            <th>Status</th>
                            <th>Published</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.Student.User.FullName</td>
                                <td>@r.Student.AdmissionNumber</td>
                                <td>@(r.Student.Class != null ? $"{r.Student.Class.Name} {r.Student.Class.Section}" : "N/A")</td>
                                <td>@r.Term</td>
                                <td>@r.AcademicYear</td>
                                <td>@r.TotalObtainedMarks / @r.TotalFullMarks</td>
                                <td class="fw-bold">@r.Percentage%</td>
                                <td>
                                    <span class="badge @(r.IsPassed ? "bg-success" : "bg-danger")">@r.OverallGrade</span>
                                </td>
                                <td>@(r.RankInClass > 0 ? r.RankInClass.ToString() : "-")</td>
                                <td>
                                    <span class="badge @(r.IsPassed ? "bg-success" : "bg-danger")">
                                        @(r.IsPassed ? "Pass" : "Fail")
                                    </span>
                                </td>
                                <td>
                                    @(r.PublishedDate.HasValue ? "Yes" : "No")
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Details", "Result", new { id = r.Id })" class="btn btn-outline-primary" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (!r.PublishedDate.HasValue)
                                        {
                                            <form asp-action="Publish" asp-controller="Result" asp-route-id="@r.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-success" title="Publish">
                                                    <i class="fas fa-share"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>