@model List<BibekSchool.Models.ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<BibekSchool.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Users</h1>
            <p class="text-muted">Manage system users and roles</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
<table class="table table-hover table-mobile-stack mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th data-mobile-hide>Phone</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th data-mobile-hide>Last Login</th>
                                <th data-mobile-hide>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>
                                    @{
                                        var roles = await UserManager.GetRolesAsync(user);
                                        var role = roles.FirstOrDefault() ?? "Student";
                                    }
                                    <span class="badge @(role == "MainAdmin" ? "bg-dark" : role == "Admin" ? "bg-danger" : role == "Teacher" ? "bg-success" : "bg-info")">
                                        @role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @if (user.IsActive)
                                        {
                                            <form asp-action="DeactivateUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Deactivate this user?');">
                                                <button type="submit" class="btn btn-outline-warning" title="Deactivate">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivateUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Activate this user?');">
                                                <button type="submit" class="btn btn-outline-success" title="Activate">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
