@{
    ViewData["Title"] = "Settings";
    Layout = "_AdminLayout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Settings</h1>
            <p class="text-muted">System configuration and settings</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">General Settings</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">School Name</label>
                            <input type="text" class="form-control" value="Bibek School" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">School Address</label>
                            <textarea class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">School Phone</label>
                            <input type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">School Email</label>
                            <input type="email" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Current Academic Year</label>
                            <input type="text" class="form-control" value="2024-2025" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Security Settings</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Session Timeout (minutes)</label>
                            <input type="number" class="form-control" value="30" min="5" max="480" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Max Login Attempts</label>
                            <input type="number" class="form-control" value="5" min="3" max="20" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password Expiry (days)</label>
                            <input type="number" class="form-control" value="90" min="30" max="365" />
                        </div>
                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox" id="require2FA" checked />
                            <label class="form-check-label" for="require2FA">Require Two-Factor Authentication</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Email Settings</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">SMTP Server</label>
                            <input type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">SMTP Port</label>
                            <input type="number" class="form-control" value="587" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Sender Email</label>
                            <input type="email" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Sender Name</label>
                            <input type="text" class="form-control" value="Bibek School" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">SMTP Password</label>
                            <input type="password" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Backup & Maintenance</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary" onclick="createBackup()">
                            <i class="fas fa-database me-2"></i>Create Database Backup
                        </button>
                        <button class="btn btn-outline-warning" onclick="clearLogs()">
                            <i class="fas fa-broom me-2"></i>Clear Old Audit Logs
                        </button>
                        <button class="btn btn-outline-info" onclick="optimizeDb()">
                            <i class="fas fa-cogs me-2"></i>Optimize Database
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function createBackup() {
            if (confirm('Create a database backup? This may take a few minutes.')) {
                alert('Backup initiated. You will be notified when complete.');
            }
        }

        function clearLogs() {
            if (confirm('Clear audit logs older than 90 days? This cannot be undone.')) {
                alert('Old logs cleared.');
            }
        }

        function optimizeDb() {
            if (confirm('Run database optimization?')) {
                alert('Database optimization completed.');
            }
        }
    </script>
}