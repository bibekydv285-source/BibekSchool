@model BibekSchool.ViewModels.AdminDashboardViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<BibekSchool.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
    ViewBag.UnreadNotificationsCount = Model.UnreadNotificationsCount;
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Admin Dashboard</h1>
            <p class="text-muted">Welcome back, @User.Identity.Name! Here's an overview of your school.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Total Students</h6>
                            <h2 class="mb-0 fw-bold text-primary">@Model.TotalStudents</h2>
                        </div>
                        <div class="stat-icon bg-primary-light">
                            <i class="fas fa-user-graduate fa-2x text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Total Teachers</h6>
                            <h2 class="mb-0 fw-bold text-success">@Model.TotalTeachers</h2>
                        </div>
                        <div class="stat-icon bg-success-light">
                            <i class="fas fa-chalkboard-teacher fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Total Classes</h6>
                            <h2 class="mb-0 fw-bold text-info">@Model.TotalClasses</h2>
                        </div>
                        <div class="stat-icon bg-info-light">
                            <i class="fas fa-door-open fa-2x text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Total Subjects</h6>
                            <h2 class="mb-0 fw-bold text-warning">@Model.TotalSubjects</h2>
                        </div>
                        <div class="stat-icon bg-warning-light">
                            <i class="fas fa-book fa-2x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Active Students</h6>
                            <h2 class="mb-0 fw-bold text-success">@Model.ActiveStudents</h2>
                        </div>
                        <div class="stat-icon bg-success-light">
                            <i class="fas fa-check-circle fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Active Teachers</h6>
                            <h2 class="mb-0 fw-bold text-info">@Model.ActiveTeachers</h2>
                        </div>
                        <div class="stat-icon bg-info-light">
                            <i class="fas fa-user-check fa-2x text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card h-100 dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Registrations</h5>
                    <a href="@Url.Action("Users", "Admin")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.RecentRegistrations.Take(10))
                                {
                                    <tr>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            @{
                                                var roles = await UserManager.GetRolesAsync(user);
                                                var role = roles.FirstOrDefault() ?? "Student";
                                            }
                                            <span class="badge @(role == "Admin" || role == "MainAdmin" ? "bg-danger" : role == "Teacher" ? "bg-success" : "bg-info")">@role</span>
                                        </td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                                @(user.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>@user.CreatedAt.ToShortDateString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Results</h5>
                    <a href="@Url.Action("Index", "Result")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var result in Model.RecentResults.Take(10))
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">@result.Student.User.FullName</h6>
                                        <small class="text-muted">@result.Term - @result.AcademicYear</small>
                                    </div>
                                    <span class="badge @(result.IsPassed ? "bg-success" : "bg-danger")">
                                        @result.OverallGrade
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-12">
            <div class="card dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Activities</h5>
                    <a href="@Url.Action("AuditLogs", "Admin")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Action</th>
                                    <th>Entity</th>
                                    <th>Entity ID</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.RecentActivities.Take(20))
                                {
                                    <tr>
                                        <td>@log.User?.FullName ?? "System"</td>
                                        <td><span class="badge bg-primary">@log.Action</span></td>
                                        <td>@log.EntityType</td>
                                        <td>@log.EntityId</td>
                                        <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@inject UserManager<BibekSchool.Models.ApplicationUser> UserManager