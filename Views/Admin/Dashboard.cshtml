@model BibekSchool.ViewModels.AdminDashboardViewModel
@using Microsoft.AspNetCore.Identity
@using System.Linq

@inject UserManager<BibekSchool.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";

    ViewBag.UnreadNotificationsCount = Model?.UnreadNotificationsCount ?? 0;
}

<div class="theme-admin admin-dashboard">

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="alert alert-danger admin-alert" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- ================================================================
         PAGE HEADER
         ================================================================ -->

    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-page-header">
                <div>
                    <h1 class="h3 mb-1">Admin Dashboard</h1>

                    <p class="text-muted mb-0">
                        Welcome back,
                        <strong>@(User.Identity?.Name ?? "Admin")</strong>!
                        Here's an overview of your school.
                    </p>
                </div>
            </div>
        </div>
    </div>


    <!-- ================================================================
         MAIN STATISTICS
         ================================================================ -->

    <div class="row g-3 mb-4">

        <!-- Total Students -->

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-primary">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">
                                Total Students
                            </h6>

                            <h2 class="mb-0 fw-bold text-primary">
                                @Model.TotalStudents
                            </h2>
                        </div>

                        <div class="stat-icon bg-primary-light">
                            <i class="fas fa-user-graduate fa-2x text-primary"></i>
                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Total Teachers -->

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-success">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">
                                Total Teachers
                            </h6>

                            <h2 class="mb-0 fw-bold text-success">
                                @Model.TotalTeachers
                            </h2>
                        </div>

                        <div class="stat-icon bg-success-light">
                            <i class="fas fa-chalkboard-teacher fa-2x text-success"></i>
                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Total Classes -->

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-info">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">
                                Total Classes
                            </h6>

                            <h2 class="mb-0 fw-bold text-info">
                                @Model.TotalClasses
                            </h2>
                        </div>

                        <div class="stat-icon bg-info-light">
                            <i class="fas fa-door-open fa-2x text-info"></i>
                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Total Subjects -->

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-warning">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">
                                Total Subjects
                            </h6>

                            <h2 class="mb-0 fw-bold text-warning">
                                @Model.TotalSubjects
                            </h2>
                        </div>

                        <div class="stat-icon bg-warning-light">
                            <i class="fas fa-book fa-2x text-warning"></i>
                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- ================================================================
         ACTIVE USERS
         ================================================================ -->

    <div class="row g-3 mb-4">

        <!-- Active Students -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card h-100 border-success">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">
                                Active Students
                            </h6>

                            <h2 class="mb-0 fw-bold text-success">
                                @Model.ActiveStudents
                            </h2>
                        </div>

                        <div class="stat-icon bg-success-light">
                            <i class="fas fa-check-circle fa-2x text-success"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Active Teachers -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card h-100 border-info">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">
                                Active Teachers
                            </h6>

                            <h2 class="mb-0 fw-bold text-info">
                                @Model.ActiveTeachers
                            </h2>
                        </div>

                        <div class="stat-icon bg-info-light">
                            <i class="fas fa-user-check fa-2x text-info"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================================
         RECENT REGISTRATIONS + RECENT RESULTS
         ================================================================ -->

    <div class="row g-3">

        <!-- Recent Registrations -->

        <div class="col-lg-8">

            <div class="card h-100 dashboard-card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <div class="dashboard-card-title">
                        <i class="fas fa-users"></i>
                        <h5 class="mb-0">Recent Registrations</h5>
                    </div>

                    <a href="@Url.Action("Users", "Admin")"
                       class="btn btn-sm btn-outline-primary">

                        View All

                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover table-mobile-stack mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th>Name</th>
                                    <th data-mobile-hide>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th data-mobile-hide>Joined</th>
                                </tr>

                            </thead>


                            <tbody>

                                @if (Model.RecentRegistrations != null &&
                                     Model.RecentRegistrations.Any())
                                {
                                    @foreach (var user in Model.RecentRegistrations.Take(10))
                                    {
                                        var roles = await UserManager.GetRolesAsync(user);

                                        var role = roles.FirstOrDefault() ?? "Student";

                                        <tr>

                                            <td>
                                                <div class="user-name-cell">
                                                    <div class="user-avatar">
                                                        @(string.IsNullOrEmpty(user.FullName)
                                                            ? "U"
                                                            : user.FullName.Substring(0, 1).ToUpper())
                                                    </div>

                                                    <span>
                                                        @user.FullName
                                                    </span>
                                                </div>
                                            </td>


                                            <td data-mobile-hide>
                                                @user.Email
                                            </td>


                                            <td>

                                                <span class="badge
                                                    @(role == "Admin" || role == "MainAdmin"
                                                        ? "bg-danger"
                                                        : role == "Teacher"
                                                            ? "bg-success"
                                                            : "bg-info")">

                                                    @role

                                                </span>

                                            </td>


                                            <td>

                                                <span class="badge
                                                    @(user.IsActive
                                                        ? "bg-success"
                                                        : "bg-secondary")">

                                                    @(user.IsActive
                                                        ? "Active"
                                                        : "Inactive")

                                                </span>

                                            </td>


                                            <td data-mobile-hide>

                                                @user.CreatedAt.ToShortDateString()

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="5">

                                            <div class="empty-state">

                                                <i class="fas fa-users"></i>

                                                <p class="mb-0">
                                                    No recent registrations found.
                                                </p>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- Recent Results -->

        <div class="col-lg-4">

            <div class="card h-100 dashboard-card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <div class="dashboard-card-title">

                        <i class="fas fa-graduation-cap"></i>

                        <h5 class="mb-0">
                            Recent Results
                        </h5>

                    </div>

                    <a href="@Url.Action("Index", "Result")"
                       class="btn btn-sm btn-outline-primary">

                        View All

                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>

                </div>


                <div class="card-body p-0">

                    <div class="list-group list-group-flush">

                        @if (Model.RecentResults != null &&
                             Model.RecentResults.Any())
                        {
                            @foreach (var result in Model.RecentResults.Take(10))
                            {
                                <div class="list-group-item">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div>

                                            <h6 class="mb-1">

                                                @(result.Student?.User?.FullName
                                                    ?? "Unknown Student")

                                            </h6>


                                            <small class="text-muted">

                                                @result.Term -
                                                @result.AcademicYear

                                            </small>

                                        </div>


                                        <span class="badge
                                            @(result.IsPassed
                                                ? "bg-success"
                                                : "bg-danger")">

                                            @result.OverallGrade

                                        </span>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state p-4">

                                <i class="fas fa-chart-line"></i>

                                <p class="mb-0">
                                    No recent results found.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================================
         RECENT ACTIVITIES
         ================================================================ -->

    <div class="row g-3 mt-3">

        <div class="col-12">

            <div class="card dashboard-card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <div class="dashboard-card-title">

                        <i class="fas fa-history"></i>

                        <h5 class="mb-0">
                            Recent Activities
                        </h5>

                    </div>


                    <a href="@Url.Action("AuditLogs", "Admin")"
                       class="btn btn-sm btn-outline-primary">

                        View All

                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover table-mobile-stack mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>User</th>
                                    <th>Action</th>
                                    <th data-mobile-hide>Entity</th>
                                    <th data-mobile-hide>Entity ID</th>
                                    <th data-mobile-hide>Time</th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model.RecentActivities != null &&
                                     Model.RecentActivities.Any())
                                {
                                    @foreach (var log in Model.RecentActivities.Take(20))
                                    {
                                        <tr>

                                            <td>

                                                @(log.User?.FullName ?? "System")

                                            </td>


                                            <td>

                                                <span class="badge bg-primary">

                                                    @log.Action

                                                </span>

                                            </td>


                                            <td data-mobile-hide>

                                                @log.EntityType

                                            </td>


                                            <td data-mobile-hide>

                                                @log.EntityId

                                            </td>


                                            <td data-mobile-hide>

                                                @log.CreatedAt.ToString(
                                                    "yyyy-MM-dd HH:mm")

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="5">

                                            <div class="empty-state">

                                                <i class="fas fa-history"></i>

                                                <p class="mb-0">

                                                    No recent activities found.

                                                </p>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>