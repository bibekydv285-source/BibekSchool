@model BibekSchool.Models.Result
@inject BibekSchool.Services.IMarkService MarkService
@{
    ViewData["Title"] = "My Results";
    Layout = "_StudentLayout";
    ViewBag.UnreadNotificationsCount = 0;
}

<div class="dashboard student-theme">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">My Results</h1>
            <p class="text-muted">View your term and final results</p>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card result-card">
                    <div class="card-header bg-@(Model.IsPassed ? "success" : "danger") text-white">
                        <h5 class="mb-0">@Model.Term Result</h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <span class="badge bg-@(Model.IsPassed ? "success" : "danger") fs-1 p-3">@Model.OverallGrade</span>
                        </div>
                        <h2 class="fw-bold">@Model.Percentage%</h2>
                        <p class="text-muted">@Model.TotalObtainedMarks / @Model.TotalFullMarks</p>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="fw-bold">@Model.RankInClass</div>
                                <div class="small text-muted">Rank</div>
                            </div>
                            <div class="col-6">
                                <div class="fw-bold">@Model.TotalStudentsInClass</div>
                                <div class="small text-muted">Total Students</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <span class="badge bg-@(Model.IsPassed ? "success" : "danger") fs-6">
                                @(Model.IsPassed ? "PASSED" : "FAILED")
                            </span>
                        </div>
                        @if (Model.PublishedDate.HasValue)
                        {
                            <div class="mt-2 small text-muted">
                                Published: @Model.PublishedDate.Value.ToShortDateString()
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Subject-wise Marks</h5>
                    </div>
                    <div class="card-body p-0">
                        @{
                            var marks = await MarkService.GetMarksByStudentAsync(Model.StudentId, Model.AcademicYear);
                        }
                        @if (marks.Any())
                        {
                            <div class="table-responsive marks-table">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Subject</th>
                                            <th>Full Marks</th>
                                            <th>Obtained</th>
                                            <th>Percentage</th>
                                            <th>Grade</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mark in marks)
                                        {
                                            var percentage = mark.FullMarks > 0 ? Math.Round((double)mark.ObtainedMarks / mark.FullMarks * 100, 2) : 0;
                                            <tr>
                                                <td>@mark.SubjectName</td>
                                                <td>@mark.FullMarks</td>
                                                <td class="fw-bold">@mark.ObtainedMarks</td>
                                                <td>
                                                    <div class="progress" style="height: 15px;">
                                                        <div class="progress-bar @(mark.IsPassed ? "bg-success" : "bg-danger")" role="progressbar" style="width: @percentage%"></div>
                                                    </div>
                                                    <small>@percentage%</small>
                                                </td>
                                                <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@mark.Grade</span></td>
                                                <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@(mark.IsPassed ? "Pass" : "Fail")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-clipboard-check fa-2x text-muted mb-2"></i>
                                <p class="text-muted">No marks available for this result</p>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">Teacher Remarks</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-0">@Model.Remarks</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                <h4>No Results Published</h4>
                <p class="text-muted">Your results will appear here once published by the administration.</p>
            </div>
        </div>
    }
</div>