@model List<BibekSchool.Models.Subject>
@{
    ViewData["Title"] = "Subjects";
    Layout = "_AdminLayout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0">Subjects</h1>
                <p class="text-muted">Manage school subjects</p>
            </div>
            <a href="@Url.Action("Create", "Subject")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Subject
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Full Marks</th>
                            <th>Pass Marks</th>
                            <th>Classes</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Code</td>
                                <td>@s.Name</td>
                                <td>
                                    <span class="badge @(s.IsCoreSubject ? "bg-primary" : "bg-secondary")">
                                        @(s.IsCoreSubject ? "Core" : "Optional")
                                    </span>
                                </td>
                                <td>@s.FullMarks</td>
                                <td>@s.PassMarks</td>
                                <td>@s.ClassSubjects.Count(cs => cs.IsActive)</td>
                                <td>
                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Details", "Subject", new { id = s.Id })" class="btn btn-outline-primary" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", "Subject", new { id = s.Id })" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-controller="Subject" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Are you sure you want to deactivate this subject?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger" title="Deactivate">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>