@{
    var userName = User.Identity?.Name ?? "Student";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bibek School Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/student.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/responsive.css" rel="stylesheet" />
</head>
<body class="student-theme">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
            <div class="sidebar-header">
                <a href="@Url.Action("Dashboard", "Student")" class="brand-link">
                    <i class="fas fa-user-graduate fa-lg me-2"></i>
                    <span class="fw-bold">Bibek School</span>
                    <span class="badge bg-light text-info ms-2 small">Student</span>
                </a>
            </div>
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Student")">
                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Profile" ? "active" : "")" href="@Url.Action("Profile", "Student")">
                            <i class="fas fa-user me-2"></i>My Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Class" ? "active" : "")" href="@Url.Action("Class", "Student")">
                            <i class="fas fa-door-open me-2"></i>My Class
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Subjects" ? "active" : "")" href="@Url.Action("Subjects", "Student")">
                            <i class="fas fa-book me-2"></i>My Subjects
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Marks" ? "active" : "")" href="@Url.Action("Marks", "Student")">
                            <i class="fas fa-clipboard-check me-2"></i>My Marks
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Results" ? "active" : "")" href="@Url.Action("Results", "Student")">
                            <i class="fas fa-chart-bar me-2"></i>My Results
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Notifications" ? "active" : "")" href="@Url.Action("Notifications", "Student")">
                            <i class="fas fa-bell me-2"></i>Notifications
                            @if (ViewBag.UnreadNotificationsCount > 0)
                            {
                                <span class="badge bg-danger ms-auto">@ViewBag.UnreadNotificationsCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Profile")">
                            <i class="fas fa-cog me-2"></i>Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <hr class="sidebar-divider" />
                    </li>
                    <li class="nav-item">
                        <form asp-action="Logout" asp-controller="Account" method="post" class="w-100">
                            <button type="submit" class="nav-link w-100 text-danger d-flex align-items-center justify-content-start px-3 py-2" style="background: none; border: none;">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Sidebar overlay for mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        <!-- Main content area -->
        <div class="main-content">
            <!-- Topbar -->
            <header class="topbar" role="banner">
                <div class="topbar-inner">
                    <button class="btn btn-ghost d-lg-none" id="sidebarToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h4 class="topbar-title mb-0">@ViewData["Title"]</h4>
                    <div class="dropdown ms-auto">
                        <a class="btn btn-ghost d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                            <i class="fas fa-user-circle fa-lg"></i>
                            <span class="d-none d-md-inline">@userName</span>
                            <span class="badge bg-info ms-2 d-none d-sm-inline">Student</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Profile")"><i class="fas fa-user me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Profile")"><i class="fas fa-key me-2"></i>Change Password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-action="Logout" asp-controller="Account" method="post">
                                    <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <main class="content" id="main-content" role="main">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/student.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>