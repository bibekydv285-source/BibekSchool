@model BibekSchool.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="login-page">
    <div class="login-container">
        <div class="login-card text-center">
            <div class="login-header">
                <div class="logo text-danger">
                    <i class="fas fa-exclamation-triangle fa-3x"></i>
                </div>
                <h2 class="fw-bold text-danger">Error</h2>
                <p class="text-muted">An error occurred while processing your request</p>
            </div>

            <div class="mt-4">
                @if (Model != null && !string.IsNullOrEmpty(Model.RequestId))
                {
                    <p class="text-muted">
                        Request ID: <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-grid gap-2">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Go Home
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Go Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>