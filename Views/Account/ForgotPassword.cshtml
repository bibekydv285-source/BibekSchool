@model BibekSchool.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="logo">
            <i class="fas fa-key"></i>
        </div>
        <h2 class="fw-bold">Forgot Password</h2>
        <p class="text-muted" id="stepDescription">Enter your registered email to receive a verification code</p>
    </div>

    <form id="forgotPasswordForm">
        @Html.AntiForgeryToken()

        <!-- Step 1: Email Entry -->
        <div class="form-step" id="step1" data-step="1">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="Enter your registered email" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-grid">
                <button type="button" id="btnSendCode" class="btn btn-primary btn-lg" data-loading-text="Sending...">
                    <i class="fas fa-paper-plane me-2"></i><span class="btn-text">Send Verification Code</span>
                </button>
            </div>
        </div>

        <!-- Step 2: OTP Verification -->
        <div class="form-step d-none" id="step2" data-step="2">
            <div class="mb-3">
                <label class="form-label">Verification Code</label>
                <div class="otp-input-group">
                    <input type="text" id="otp1" class="form-control otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 1" />
                    <input type="text" id="otp2" class="form-control otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 2" />
                    <input type="text" id="otp3" class="form-control otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 3" />
                    <input type="text" id="otp4" class="form-control otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 4" />
                    <input type="text" id="otp5" class="form-control otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 5" />
                    <input type="text" id="otp6" class="form-control otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 6" />
                    <input type="hidden" id="otpCode" name="OtpCode" />
                </div>
                <span class="text-danger" id="otpError"></span>
                <div class="form-text text-center mt-2">
                    Code sent to <strong id="otpEmail"></strong>
                </div>
            </div>

            <div class="d-grid mb-2">
                <button type="button" id="btnVerifyCode" class="btn btn-primary btn-lg" data-loading-text="Verifying...">
                    <i class="fas fa-check me-2"></i><span class="btn-text">Verify Code</span>
                </button>
            </div>

            <div class="text-center">
                <button type="button" id="btnResendCode" class="btn btn-link text-decoration-none small" disabled>
                    Resend code (<span id="resendCountdown">60</span>s)
                </button>
            </div>
        </div>

        <!-- Step 3: New Password -->
        <div class="form-step d-none" id="step3" data-step="3">
            <div class="mb-3">
                <label for="NewPassword" class="form-label">New Password</label>
                <div class="input-group">
                    <input type="password" id="NewPassword" name="NewPassword" class="form-control" placeholder="Enter new password" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary toggle-password" type="button" data-target="NewPassword" aria-label="Toggle password visibility">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span class="text-danger" id="newPasswordError"></span>
                <div class="form-text">Password must be at least 6 characters.</div>
                <div class="password-strength mt-2" id="passwordStrength" style="display: none;">
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                    </div>
                    <small class="text-muted" id="passwordStrengthText"></small>
                </div>
            </div>

            <div class="mb-3">
                <label for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <div class="input-group">
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" placeholder="Confirm new password" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary toggle-password" type="button" data-target="ConfirmPassword" aria-label="Toggle password visibility">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span class="text-danger" id="confirmPasswordError"></span>
            </div>

            <div class="d-grid">
                <button type="button" id="btnResetPassword" class="btn btn-success btn-lg" data-loading-text="Resetting...">
                    <i class="fas fa-save me-2"></i><span class="btn-text">Reset Password</span>
                </button>
            </div>
        </div>
    </form>

    <div class="text-center mt-3">
        <p class="mb-0">Remember your password? <a href="@Url.Action("Login", "Account")" class="text-decoration-none">Back to Login</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Forgot password flow is now in dashboard.js (initForgotPasswordFlow) -->
    <!-- OTP styles are now in auth.css -->
   
}