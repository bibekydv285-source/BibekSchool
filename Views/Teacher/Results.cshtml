@model List<BibekSchool.Models.Result>
@{
    ViewData["Title"] = "Results";
    Layout = "_TeacherLayout";
    ViewBag.UnreadNotificationsCount = 0;
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Results</h1>
            <p class="text-muted">View student results for your classes</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Admission No.</th>
                                <th>Class</th>
                                <th>Term</th>
                                <th>Academic Year</th>
                                <th>Total Marks</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                                <th>Rank</th>
                                <th>Status</th>
                                <th>Published</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>@result.Student.User.FullName</td>
                                    <td>@result.Student.AdmissionNumber</td>
                                    <td>@(result.Student.Class != null ? $"{result.Student.Class.Name} {result.Student.Class.Section}" : "N/A")</td>
                                    <td>@result.Term</td>
                                    <td>@result.AcademicYear</td>
                                    <td>@result.TotalObtainedMarks / @result.TotalFullMarks</td>
                                    <td class="fw-bold">@result.Percentage%</td>
                                    <td><span class="badge @(result.IsPassed ? "bg-success" : "bg-danger")">@result.OverallGrade</span></td>
                                    <td>@(result.RankInClass > 0 ? result.RankInClass.ToString() : "-")</td>
                                    <td><span class="badge @(result.IsPassed ? "bg-success" : "bg-danger")">@(result.IsPassed ? "Pass" : "Fail")</span></td>
                                    <td>@(result.PublishedDate.HasValue ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                <h4>No Results Available</h4>
                <p class="text-muted">No results have been generated for your classes yet.</p>
            </div>
        </div>
    }
</div>