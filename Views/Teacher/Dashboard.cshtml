@model BibekSchool.ViewModels.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "_TeacherLayout";
    ViewBag.UnreadNotificationsCount = Model.UnreadNotificationsCount;
}

<div class="dashboard teacher-theme">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Welcome, @Model.Teacher?.User.FullName!</h1>
            <p class="text-muted">Employee ID: @Model.Teacher?.EmployeeId | @Model.Teacher?.Designation</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">My Classes</h6>
                            <h2 class="mb-0 fw-bold text-primary">@Model.TotalClasses</h2>
                        </div>
                        <div class="stat-icon bg-primary-light">
                            <i class="fas fa-door-open fa-2x text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">My Students</h6>
                            <h2 class="mb-0 fw-bold text-info">@Model.TotalStudents</h2>
                        </div>
                        <div class="stat-icon bg-info-light">
                            <i class="fas fa-user-graduate fa-2x text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">My Subjects</h6>
                            <h2 class="mb-0 fw-bold text-success">@Model.TotalSubjects</h2>
                        </div>
                        <div class="stat-icon bg-success-light">
                            <i class="fas fa-book fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted text-uppercase small mb-1">Pending Marks</h6>
                            <h2 class="mb-0 fw-bold text-warning">@Model.PendingMarksCount</h2>
                        </div>
                        <div class="stat-icon bg-warning-light">
                            <i class="fas fa-clipboard-list fa-2x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card h-100 dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">My Classes</h5>
                    <a href="@Url.Action("Classes", "Teacher")" class="btn btn-sm btn-outline-success">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.AssignedClasses.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var classItem in Model.AssignedClasses)
                            {
                                <a href="@Url.Action("Students", "Teacher", new { classId = classItem.Id })" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@classItem.Name @classItem.Section</h6>
                                        <small class="text-muted">@classItem.Students.Count students | @classItem.AcademicYear</small>
                                    </div>
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 empty-state">
                            <i class="fas fa-door-open fa-2x text-muted mb-2"></i>
                            <p class="text-muted">No classes assigned</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">My Subjects</h5>
                    <a href="@Url.Action("Subjects", "Teacher")" class="btn btn-sm btn-outline-success">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.AssignedSubjects.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var subject in Model.AssignedSubjects)
                            {
                                <a href="@Url.Action("Marks", "Teacher", new { subjectId = subject.Id })" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@subject.Name</h6>
                                        <small class="text-muted">@subject.Code | Full Marks: @subject.FullMarks</small>
                                    </div>
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 empty-state">
                            <i class="fas fa-book fa-2x text-muted mb-2"></i>
                            <p class="text-muted">No subjects assigned</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-lg-8">
            <div class="card h-100 dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Notifications</h5>
                    <a href="@Url.Action("Notifications", "Teacher")" class="btn btn-sm btn-outline-success">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.Notifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.Notifications.Take(5))
                            {
                                <div class="list-group-item @(!notification.IsRead ? "bg-light" : "")">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-1 @(!notification.IsRead ? "fw-bold" : "")">@notification.Title</h6>
                                        <small class="text-muted">@notification.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                    </div>
                                    <p class="mb-0 small">@notification.Message</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 empty-state">
                            <i class="fas fa-bell-slash fa-2x text-muted mb-2"></i>
                            <p class="text-muted">No notifications</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 dashboard-card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body quick-actions">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Marks", "Teacher")" class="btn btn-outline-success">
                            <i class="fas fa-plus me-2"></i>Add Marks
                        </a>
                        <a href="@Url.Action("Results", "Teacher")" class="btn btn-outline-primary">
                            <i class="fas fa-chart-bar me-2"></i>View Results
                        </a>
                        <a href="@Url.Action("Notifications", "Teacher")" class="btn btn-outline-warning">
                            <i class="fas fa-bell me-2"></i>Notifications
                        </a>
                        <a href="@Url.Action("Index", "Profile")" class="btn btn-outline-secondary">
                            <i class="fas fa-user me-2"></i>Profile
                        </a>
                        <a href="@Url.Action("ChangePassword", "Profile")" class="btn btn-outline-info">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>