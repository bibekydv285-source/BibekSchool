@model List<BibekSchool.Models.Mark>
@{
    ViewData["Title"] = "Marks";
    Layout = "_TeacherLayout";
    ViewBag.UnreadNotificationsCount = 0;
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h3 mb-0">Marks</h1>
                <p class="text-muted">Manage student marks</p>
            </div>
            <a href="@Url.Action("CreateMark", "Teacher")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Mark
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Class</label>
                    <select name="classId" class="form-select" asp-items="@(new SelectList(ViewBag.Classes as IEnumerable<BibekSchool.Models.SchoolClass>, "Id", "Name", ViewBag.SelectedClassId))">
                        <option value="">All Classes</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Subject</label>
                    <select name="subjectId" class="form-select" asp-items="@(new SelectList(ViewBag.Subjects as IEnumerable<BibekSchool.Models.Subject>, "Id", "Name", ViewBag.SelectedSubjectId))">
                        <option value="">All Subjects</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Academic Year</label>
                    <input type="text" name="academicYear" class="form-control" value="@ViewBag.AcademicYear" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Exam Name</label>
                    <input type="text" name="examName" class="form-control" value="@ViewBag.ExamName" placeholder="e.g., First Term" />
                </div>
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Admission No.</th>
                                <th>Subject</th>
                                <th>Exam</th>
                                <th>Academic Year</th>
                                <th>Full Marks</th>
                                <th>Obtained</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                                <th>Status</th>
                                <th>Exam Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mark in Model)
                            {
                                var percentage = mark.FullMarks > 0 ? Math.Round((double)mark.ObtainedMarks / mark.FullMarks * 100, 2) : 0;
                                <tr>
                                    <td>@mark.Student.User.FullName</td>
                                    <td>@mark.Student.AdmissionNumber</td>
                                    <td>@mark.Subject.Name</td>
                                    <td>@mark.ExamName</td>
                                    <td>@mark.AcademicYear</td>
                                    <td>@mark.FullMarks</td>
                                    <td class="fw-bold">@mark.ObtainedMarks</td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @(mark.IsPassed ? "bg-success" : "bg-danger")" role="progressbar" style="width: @percentage%"></div>
                                        </div>
                                        <small>@percentage%</small>
                                    </td>
                                    <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@mark.Grade</span></td>
                                    <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@(mark.IsPassed ? "Pass" : "Fail")</span></td>
                                    <td>@mark.ExamDate.ToShortDateString()</td>
                                    <td>
                                        <a href="@Url.Action("EditMark", "Teacher", new { id = mark.Id })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                <h4>No Marks Found</h4>
                <p class="text-muted">No marks match the current filters.</p>
            </div>
        </div>
    }
</div>