@model List<BibekSchool.Models.Student>
@{
    ViewData["Title"] = "Students";
    Layout = "_Layout";
    ViewBag.UnreadNotificationsCount = 0;
    var className = ViewBag.ClassName as string;
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0">Students</h1>
                <p class="text-muted">Class: @className</p>
            </div>
            <a href="@Url.Action("Classes", "Teacher")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Classes
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-mobile-stack mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Admission No.</th>
                                <th>Name</th>
                                <th data-mobile-hide>Roll No.</th>
                                <th data-mobile-hide>Email</th>
                                <th data-mobile-hide>Phone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>@student.AdmissionNumber</td>
                                    <td>@student.User.FullName</td>
                                    <td>@student.RollNumber</td>
                                    <td>@student.User.Email</td>
                                    <td>@student.User.PhoneNumber</td>
                                    <td>
                                        <a href="@Url.Action("Marks", "Teacher", new { classId = ViewBag.ClassId, studentId = student.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-clipboard-check me-1"></i>Marks
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                <h4>No Students Found</h4>
                <p class="text-muted">No students in this class.</p>
            </div>
        </div>
    }
</div>
