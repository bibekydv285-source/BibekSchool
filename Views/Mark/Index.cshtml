@model List<BibekSchool.ViewModels.MarkViewModel>
@{
    ViewData["Title"] = "Marks";
    Layout = "_Layout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0">Marks</h1>
                <p class="text-muted">View and manage student marks</p>
            </div>
            <a href="@Url.Action("Create", "Mark")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Mark
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Class</label>
                    <select name="classId" class="form-select" asp-items="@(new SelectList(ViewBag.Classes, "Id", "Name", ViewBag.SelectedClassId))">
                        <option value="">All Classes</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Subject</label>
                    <select name="subjectId" class="form-select" asp-items="@(new SelectList(ViewBag.Subjects, "Id", "Name", ViewBag.SelectedSubjectId))">
                        <option value="">All Subjects</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Academic Year</label>
                    <input type="text" name="academicYear" value="@ViewBag.AcademicYear" class="form-control" placeholder="2024-2025" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Exam Name</label>
                    <input type="text" name="examName" value="@ViewBag.ExamName" class="form-control" placeholder="Filter by exam" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="fas fa-filter me-2"></i>Filter
                    </button>
                    <a href="@Url.Action("Index", "Mark")" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Subject</th>
                                <th>Teacher</th>
                                <th>Exam</th>
                                <th>Academic Year</th>
                                <th>Full Marks</th>
                                <th>Obtained</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                                <th>Status</th>
                                <th>Exam Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mark in Model)
                            {
                                <tr>
                                    <td>@mark.StudentName</td>
                                    <td>@mark.SubjectName</td>
                                    <td>@mark.TeacherName</td>
                                    <td>@mark.ExamName</td>
                                    <td>@mark.AcademicYear</td>
                                    <td>@mark.FullMarks</td>
                                    <td class="fw-bold">@mark.ObtainedMarks</td>
                                    <td>
                                        <div class="progress" style="height: 15px;">
                                            <div class="progress-bar @(mark.IsPassed ? "bg-success" : "bg-danger")" role="progressbar" style="width: @Math.Min(mark.Percentage, 100)%"></div>
                                        </div>
                                        <small>@mark.Percentage.ToString("F1")%</small>
                                    </td>
                                    <td><span class="badge bg-secondary">@mark.Grade</span></td>
                                    <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@(mark.IsPassed ? "Pass" : "Fail")</span></td>
                                    <td>@mark.ExamDate.ToShortDateString()</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Edit", "Mark", new { id = mark.Id })" class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@mark.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this mark?')">
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No marks found</h5>
                    <p class="text-muted">Click "Add Mark" to create a new mark record.</p>
                    <a href="@Url.Action("Create", "Mark")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Mark
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
