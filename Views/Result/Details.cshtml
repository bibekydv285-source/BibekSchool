@model BibekSchool.ViewModels.ResultViewModel
@{
    ViewData["Title"] = "Result Details";
    Layout = "_Layout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0">Result Details</h1>
                <p class="text-muted">@Model.StudentName | @Model.ClassName</p>
            </div>
            <div>
                <a href="@Url.Action("Index", "Result")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-@(Model.IsPassed ? "success" : "danger") text-white">
                    <h5 class="mb-0">@Model.Term Result</h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span class="badge bg-@(Model.IsPassed ? "success" : "danger") fs-1 p-3">@Model.OverallGrade</span>
                    </div>
                    <h2 class="fw-bold">@Model.Percentage%</h2>
                    <p class="text-muted">@Model.TotalObtainedMarks / @Model.TotalFullMarks</p>
                    <hr />
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fw-bold">@Model.RankInClass</div>
                            <div class="small text-muted">Rank</div>
                        </div>
                        <div class="col-6">
                            <div class="fw-bold">@Model.TotalStudentsInClass</div>
                            <div class="small text-muted">Total Students</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-@(Model.IsPassed ? "success" : "danger") fs-6">
                            @(Model.IsPassed ? "PASSED" : "FAILED")
                        </span>
                    </div>
                    @if (Model.PublishedDate.HasValue)
                    {
                        <div class="mt-2 small text-muted">
                            Published: @Model.PublishedDate.Value.ToShortDateString()
                        </div>
                        <div class="small text-muted">
                            By: @Model.PublishedBy
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Subject-wise Marks</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.SubjectMarks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Subject</th>
                                        <th>Exam</th>
                                        <th>Full Marks</th>
                                        <th>Obtained</th>
                                        <th>Percentage</th>
                                        <th>Grade</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mark in Model.SubjectMarks)
                                    {
                                        var percentage = mark.FullMarks > 0 ? Math.Round((double)mark.ObtainedMarks / mark.FullMarks * 100, 2) : 0;
                                        <tr>
                                            <td>@mark.SubjectName</td>
                                            <td>@mark.ExamName</td>
                                            <td>@mark.FullMarks</td>
                                            <td class="fw-bold">@mark.ObtainedMarks</td>
                                            <td>
                                                <div class="progress" style="height: 15px;">
                                                    <div class="progress-bar @(mark.IsPassed ? "bg-success" : "bg-danger")" role="progressbar" style="width: @percentage%"></div>
                                                </div>
                                                <small>@percentage%</small>
                                            </td>
                                            <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@mark.Grade</span></td>
                                            <td><span class="badge @(mark.IsPassed ? "bg-success" : "bg-danger")">@(mark.IsPassed ? "Pass" : "Fail")</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No subject marks available</p>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">Remarks</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Remarks</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
