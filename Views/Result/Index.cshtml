@model List<BibekSchool.ViewModels.ResultViewModel>
@{
    ViewData["Title"] = "Results";
    Layout = "_Layout";
}

<div class="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0">Results</h1>
                <p class="text-muted">View and manage student results</p>
            </div>
            @if (User.IsInRole("MainAdmin") || User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Generate", "Result")" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Generate Result
                </a>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Academic Year</label>
                    <input type="text" name="academicYear" value="@ViewBag.AcademicYear" class="form-control" placeholder="2024-2025" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Term</label>
                    <select name="term" class="form-select" asp-items="@(new SelectList(ViewBag.Terms, ViewBag.Term))">
                        <option value="">All Terms</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary me-2">
                        <i class="fas fa-filter me-2"></i>Filter
                    </button>
                    <a href="@Url.Action("Index", "Result")" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-mobile-stack mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Class</th>
                                <th>Term</th>
                                <th data-mobile-hide>Academic Year</th>
                                <th data-mobile-hide>Total Marks</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                                <th data-mobile-hide>Rank</th>
                                <th>Status</th>
                                <th data-mobile-hide>Published</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>@result.StudentName</td>
                                    <td>@result.ClassName</td>
                                    <td>@result.Term</td>
                                    <td>@result.AcademicYear</td>
                                    <td>@result.TotalObtainedMarks / @result.TotalFullMarks</td>
                                    <td>
                                        <div class="progress" style="height: 15px;">
                                            <div class="progress-bar @(result.IsPassed ? "bg-success" : "bg-danger")" role="progressbar" style="width: @Math.Min(result.Percentage, 100)%"></div>
                                        </div>
                                        <small>@result.Percentage.ToString("F1")%</small>
                                    </td>
                                    <td><span class="badge bg-secondary">@result.OverallGrade</span></td>
                                    <td>
                                        @if (result.RankInClass.HasValue && result.TotalStudentsInClass.HasValue)
                                        {
                                            <span>@result.RankInClass / @result.TotalStudentsInClass</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td><span class="badge @(result.IsPassed ? "bg-success" : "bg-danger")">@(result.IsPassed ? "Passed" : "Failed")</span></td>
                                    <td>
                                        @if (result.PublishedDate.HasValue)
                                        {
                                            <span class="badge bg-success">Published</span>
                                            <div class="small text-muted">@result.PublishedDate.Value.ToShortDateString()</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Draft</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", "Result", new { id = result.Id })" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!result.PublishedDate.HasValue && (User.IsInRole("MainAdmin") || User.IsInRole("Admin")))
                                            {
                                                <form asp-action="Publish" asp-route-id="@result.Id" method="post" class="d-inline" onsubmit="return confirm('Publish this result?')">
                                                    <button type="submit" class="btn btn-outline-success" title="Publish">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No results found</h5>
                    <p class="text-muted">@(User.IsInRole("MainAdmin") || User.IsInRole("Admin") ? "Click \"Generate Result\" to create a new result." : "No results available for the selected filters.")</p>
                    @if (User.IsInRole("MainAdmin") || User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("Generate", "Result")" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Generate Result
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
