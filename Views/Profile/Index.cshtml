@model BibekSchool.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile Settings";
    
    // Determine layout based on user role
    var isTeacher = User.IsInRole("Teacher");
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("MainAdmin");
    Layout = isTeacher ? "_TeacherLayout" : (isAdmin ? "_AdminLayout" : "_StudentLayout");
    
    var dashboardAction = isTeacher ? "Dashboard" : (isAdmin ? "Dashboard" : "Dashboard");
    var dashboardController = isTeacher ? "Teacher" : (isAdmin ? "Admin" : "Student");
    var dashboardIcon = isTeacher ? "fa-chalkboard-teacher" : (isAdmin ? "fa-user-shield" : "fa-user-graduate");
    var themeColor = isTeacher ? "text-success" : (isAdmin ? "text-danger" : "text-info");
    var btnColor = isTeacher ? "btn-success" : (isAdmin ? "btn-danger" : "btn-info");
}

<div class="profile-page">
    <div class="container py-4">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card profile-card">
                    <div class="card-header bg-white border-0">
                        <h4 class="mb-0 fw-bold">
                            <i class="fas fa-user-cog me-2 @themeColor"></i>Profile Settings
                        </h4>
                        <p class="text-muted mb-0">Manage your profile information and account settings</p>
                    </div>
                    <div class="card-body">
                        <form asp-action="Index" method="post" enctype="multipart/form-data">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-medium">Email <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control" readonly />
                                    <span class="text-muted small">Email cannot be changed</span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-medium">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DateOfBirth" class="form-label fw-medium">Date of Birth</label>
                                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Gender" class="form-label fw-medium">Gender</label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">&nbsp;</label>
                                    <a asp-action="ChangePassword" class="btn btn-outline-primary w-100">
                                        <i class="fas fa-key me-2"></i>Change Password
                                    </a>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label fw-medium">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn @btnColor">
                                    <i class="fas fa-save me-2"></i>Save Changes
                                </button>
                                <a asp-action="@dashboardAction" asp-controller="@dashboardController" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}