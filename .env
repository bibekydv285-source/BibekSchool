# BibekSchool - Local Development Environment Variables
# This file is loaded via dotnet user-secrets in Development environment

# =============================================================================
# LOCAL SQL SERVER (LocalDB) CONNECTION STRING
# =============================================================================
ConnectionStrings__DefaultConnection="Server=(localdb)\MSSQLLocalDB;Database=BibekSchool;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;Connection Timeout=30;"

# =============================================================================
# EMAIL SETTINGS (using mock for local development)
# =============================================================================
Email__SmtpServer="smtp.gmail.com"
Email__SmtpPort="587"
Email__SmtpUsername="your-email@gmail.com"
Email__SmtpPassword="your-app-password"
Email__FromEmail="your-email@gmail.com"
Email__FromName="Bibek School"
Email__EnableSsl="true"
Email__UseMock="true"

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
Application__Name="Bibek School"
Application__Version="1.0.0"
Application__AcademicYear="2024-2025"
Application__DefaultLanguage="en"
Application__TimeZone="Asia/Kathmandu"

# =============================================================================
# PASSWORD RESET SETTINGS
# =============================================================================
PasswordReset__OtpExpiryMinutes="10"
PasswordReset__ResendCooldownSeconds="60"
PasswordReset__MaxAttemptsPerHour="3"
PasswordReset__MaxOtpAttempts="5"

# =============================================================================
# SEED ADMIN SETTINGS (for local development)
# =============================================================================
SeedAdmin__Email="admin@bibekschool.local"
SeedAdmin__Password="Admin@123"
SeedAdmin__PhoneNumber="+1234567890"
SeedAdmin__FullName="Main Admin"